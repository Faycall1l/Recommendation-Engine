# Copy to .env and fill in — never commit real values.
# The LLM agent is backed by a self-hosted Gemma-4 model served via vLLM
# (OpenAI-compatible API). Point it at any compatible endpoint.
ATHAR_AGENT__ENABLED=true
ATHAR_AGENT__VLLM__BASE_URL=http://localhost:8000/v1
ATHAR_AGENT__VLLM__API_KEY=sk-your-key
ATHAR_AGENT__VLLM__MODEL=Gemma-4-31B-it
